{
  "name": "karya",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx server.ts",
    "start": "node server.js",
    "postinstall": "echo '[build] starting' && npx prisma generate && echo '[build] prisma done' && npm run build:all && echo '[build] build done' && (timeout 25 npx prisma db seed || echo '[build] seed skipped/timeout') && echo '[build] complete'",
    "build": "vite build",
    "build:server": "esbuild server.ts --platform=node --format=esm --bundle --packages=external --external:@neondatabase/serverless --external:@prisma/adapter-neon --external:ws --outfile=server.js",
    "build:all": "npm run build && npm run build:server",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@google/genai": "^2.7.0",
    "@google/generative-ai": "^0.24.1",
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/adapter-neon": "^6.0.0",
    "@prisma/adapter-pg": "^6.0.0",
    "pg": "^8.13.3",
    "@prisma/client": "^6.0.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcrypt": "^6.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@vitejs/plugin-react": "^5.0.4",
    "bcrypt": "^6.0.0",
    "canvas-confetti": "^1.9.4",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "nodemailer": "^8.0.5",
    "prisma": "^6.0.0",
    "puppeteer": "^25.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.13.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "vite": "^6.2.0",
    "ws": "^8.21.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "playwright": "^1.60.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
