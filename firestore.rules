rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // 1. DEFAULT DENY
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // 2. HELPER PRIMITIVES
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Auth tokens for bootstrap and primary consultants
    function isHardcodedStaff() {
      return isSignedIn() && (
        request.auth.token.email.lower() == "mkarthikeya24@gmail.com" ||
        request.auth.token.email.lower() == "kbsn1170@gmail.com" ||
        request.auth.token.email.lower() == "karya.ai.admin@gmail.com"
      );
    }

    // Database lookup for roles
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isHardcodedStaff() || (isSignedIn() && getRole() == "admin");
    }

    function isEmployee() {
      return isHardcodedStaff() || (isSignedIn() && (getRole() == "employee" || getRole() == "admin"));
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // ===============================================================
    // 3. VALIDATION BLUEPRINTS
    // ===============================================================
    function isValidUser(data) {
      return data.uid is string && data.uid.size() > 0 &&
             data.email is string && data.email.size() > 0 &&
             data.role is string && (data.role == "admin" || data.role == "employee" || data.role == "client") &&
             (!("assigned_clients" in data) || data.assigned_clients is list) &&
             (!("isBanned" in data) || data.isBanned is bool) &&
             (!("createdAt" in data) || data.createdAt is string);
    }

    function isValidClient(data) {
      return (!("status" in data) || data.status is string) && 
             (!("application_data" in data) || data.application_data is map);
    }

    function isValidResumeHistory(data) {
      return data.userId is string && data.userId.size() > 0 &&
             data.resumeText is string && data.resumeText.size() > 0 &&
             (!("jobId" in data) || data.jobId == null || data.jobId is string) &&
             (!("company" in data) || data.company is string) &&
             (!("role" in data) || data.role is string) &&
             (!("atsScore" in data) || data.atsScore is number) &&
             (!("createdAt" in data) || data.createdAt is string);
    }

    // ===============================================================
    // 4. COLLECTION RULES
    // ===============================================================

    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isEmployee());
      allow list: if isEmployee();
      allow create: if isOwner(userId) && isValidUser(incoming()) && (incoming().role == "client" || isHardcodedStaff());
      allow update: if isEmployee() || (isOwner(userId) && isValidUser(incoming()) && incoming().role == existing().role);
      allow delete: if isEmployee();
    }

    match /clients/{clientId} {
      allow get: if isSignedIn() && (clientId == request.auth.uid || isEmployee());
      allow list: if isEmployee();
      allow create: if (isOwner(clientId) || isEmployee()) && isValidClient(incoming());
      allow update: if isEmployee() || (
        isOwner(clientId) && 
        isValidClient(incoming()) && 
        incoming().get('assigned_employee_id', existing().get('assigned_employee_id', 'none')) == existing().get('assigned_employee_id', 'none') &&
        (
          incoming().get('status', 'unknown') == existing().get('status', 'unknown') ||
          (existing().get('status', 'incomplete') == "incomplete" && incoming().get('status', 'unknown') == "pending_approval")
        )
      );
      allow delete: if isAdmin();

      match /job_tracker/{jobId} {
        allow read, write: if isSignedIn() && (clientId == request.auth.uid || isEmployee());
      }
    }

    match /resumeHistory/{resumeId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isEmployee());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isEmployee());
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid || isEmployee()) && isValidResumeHistory(incoming());
      allow update, delete: if isAdmin();
    }

    match /jobs/{jobId} {
      allow read, write: if isSignedIn() && (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isEmployee());
    }

    match /interviewPreps/{prepId} {
      allow read, write: if isSignedIn() && (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isEmployee());
    }

    match /pre_registrations/{email} {
      allow get: if true; // Public access for invitation verification
      allow list, write: if isEmployee();
    }

    match /system_announcements/{announcementId} {
      allow read: if true; // Changed to true for boot-test safety
      allow write: if isAdmin();
    }

    match /intelligence_leads/{leadId} {
      allow read, write: if isEmployee();
    }

    match /intelligence_timeline/{eventId} {
      allow read, write: if isEmployee();
    }

    match /intelligence_broadcasts/{blastId} {
      allow read, write: if isEmployee();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Collection Group for Admin Global View
    match /{path=**}/job_tracker/{jobId} {
      allow read: if isEmployee();
    }
  }
}
